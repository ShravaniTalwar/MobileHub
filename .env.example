# =======================================================
# MobileHub Environment Configuration Template
# Copy this file to .env and adjust variables as required
# =======================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database (Required when SPRING_PROFILES_ACTIVE=mysql)
DATABASE_URL=jdbc:mysql://localhost:3306/mobilehub?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Payment Gateway (Razorpay Sandbox / Test Mode)
RAZORPAY_KEY_ID=rzp_test_mobilehub123456
RAZORPAY_KEY_SECRET=mock_secret_key_789

# Cloudinary / Image Storage (Optional)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# Email Notification Service (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_user
MAIL_PASSWORD=your_mailtrap_password
